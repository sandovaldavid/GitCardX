---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardEditorPanel from '../components/smart/CardEditorPanel.astro';
import ColorControlsPanel from '../components/smart/ColorControlsPanel.astro';
import ImageUploadPanel from '../components/smart/ImageUploadPanel.astro';
import ExportControls from '../components/smart/ExportControls.astro';
import ToastHost from '../components/smart/ToastHost.astro';
import CardPreview from '../components/ui/CardPreview.astro';
---

<BaseLayout>
	<header class="app-header">
		<div class="logo-container">
			<img src="/images/logo-github-card-generator.webp" alt="Logo" class="app-logo" />
			<h1>GitCardX</h1>
		</div>
	</header>

	<div class="container">
		<div class="app-layout">
			<div class="side-panel left-panel">
				<CardEditorPanel />
			</div>

			<div class="center-panel">
				<div class="preview-header">
					<h2><i class="fas fa-eye"></i> Preview</h2>
					<ExportControls />
				</div>

				<CardPreview />
			</div>

			<div class="side-panel right-panel">
				<ColorControlsPanel />
				<ImageUploadPanel />
			</div>
		</div>
	</div>

	<footer class="app-footer">
		<div class="footer-content">
			<div class="footer-logo animate-on-scroll">
				<img src="/images/logo-github-card-generator.webp" alt="Logo" class="footer-logo-img" />
				<h3>GitCardX</h3>
			</div>

			<div class="footer-links animate-on-scroll">
				<h4>Links</h4>
				<ul>
					<li>
						<a href="/" class="footer-link"><i class="fas fa-home"></i> Home</a>
					</li>
					<li>
						<a
							href="https://github.com/sandovaldavid/gitHub-project-card-generator"
							target="_blank"
							class="footer-link"
						>
							<i class="fas fa-code"></i> Source Code
						</a>
					</li>
				</ul>
			</div>

			<div class="footer-social animate-on-scroll">
				<h4>Connect</h4>
				<div class="social-icons">
					<a
						href="https://github.com/sandovaldavid"
						class="social-icon"
						target="_blank"
						title="GitHub"><i class="fab fa-github"></i></a
					>
					<a href="https://x.com/XDavid2S" class="social-icon" target="_blank" title="Twitter"
						><i class="fab fa-twitter"></i></a
					>
					<a
						href="https://www.linkedin.com/in/jdavidsandovals/"
						class="social-icon"
						target="_blank"
						title="LinkedIn"><i class="fab fa-linkedin"></i></a
					>
					<a href="#" class="social-icon" target="_blank" title="Instagram"
						><i class="fab fa-instagram"></i></a
					>
				</div>
			</div>

			<div class="footer-newsletter animate-on-scroll">
				<h4>Newsletter</h4>
				<p>Receive updates and news from this page</p>
				<div class="newsletter-form">
					<input type="email" placeholder="Tu email" class="newsletter-input" />
					<button class="newsletter-button"><i class="fas fa-paper-plane"></i></button>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>
				&copy; <span id="current-year">2025</span> GitCardX | by
				<a href="https://github.com/sandovaldavid" target="_blank">@sandovaldavid</a>
			</p>
		</div>
	</footer>

	<ToastHost />
</BaseLayout>

<script>
	import { cardStore, colorStore, imageStore } from '../stores/cardState';
	import { load, save } from '../lib/storage';
	import { AUTOSAVE_DEBOUNCE_MS } from '../constants/defaults';

	// Restore any saved settings before wiring the autosave subscriber, so the
	// initial restore doesn't immediately re-trigger a save.
	load();

	let saveTimer: ReturnType<typeof setTimeout> | undefined;
	function scheduleSave() {
		clearTimeout(saveTimer);
		saveTimer = setTimeout(save, AUTOSAVE_DEBOUNCE_MS);
	}

	cardStore.subscribe(scheduleSave);
	colorStore.subscribe(scheduleSave);
	imageStore.subscribe(scheduleSave);

	const currentYear = document.getElementById('current-year');
	if (currentYear) currentYear.textContent = String(new Date().getFullYear());

	const elementsToAnimate = document.querySelectorAll('.animate-on-scroll');
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (entry.isIntersecting) {
					entry.target.classList.add('appear');
					observer.unobserve(entry.target);
				}
			}
		},
		{ threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
	);
	elementsToAnimate.forEach((element) => observer.observe(element));
</script>

<style>
	.app-header {
		display: flex;
		justify-content: center;
		margin-top: 30px;
	}

	.logo-container {
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	.app-logo {
		width: 50px;
		height: 50px;
		border-radius: 10px;
		margin-right: 1rem;
		transition: transform 0.3s ease;
	}
	.app-logo:hover {
		transform: rotate(5deg);
	}

	h1 {
		font-size: 2.25rem;
		margin: 0;
		color: var(--border-color);
	}

	@media (max-width: 768px) {
		.app-header {
			flex-direction: column;
			align-items: center;
			text-align: center;
			margin: 20px 0;
		}
		.logo-container {
			justify-content: center;
			margin-bottom: 15px;
		}
		h1 {
			font-size: 1.8rem;
		}
	}

	@media (max-width: 480px) {
		.app-header {
			margin: 15px 0;
		}
		.app-logo {
			width: 40px;
			height: 40px;
		}
		h1 {
			font-size: 1.6rem;
		}
	}

	.app-layout {
		display: grid;
		grid-template-columns: 3fr 5fr 2fr;
		gap: 2rem;
		margin-top: 2rem;
		min-height: calc(100vh - 300px);
	}

	.side-panel {
		background-color: white;
		border-radius: 12px;
		padding: 1.5rem;
		height: fit-content;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
	}

	.center-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.preview-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	@media (max-width: 1200px) {
		.app-layout {
			grid-template-columns: 1fr 1fr;
		}
		.right-panel {
			grid-column: span 2;
			grid-row: 2;
		}
	}

	@media (max-width: 768px) {
		.app-layout {
			grid-template-columns: 1fr;
		}
		.left-panel,
		.center-panel,
		.right-panel {
			grid-column: 1;
		}
		.left-panel {
			grid-row: 1;
		}
		.center-panel {
			grid-row: 2;
		}
		.right-panel {
			grid-row: 3;
		}
	}

	.app-footer {
		background-color: var(--dark-gray);
		color: #f5f5f5;
		padding: 4rem 0 1rem;
		margin-top: 4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		position: relative;
		overflow: hidden;
	}

	.app-footer::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(90deg, var(--border-color), transparent);
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		padding: 0 2rem;
		position: relative;
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1rem;
	}

	.footer-logo-img {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		transition: transform 0.3s ease;
	}
	.footer-logo:hover .footer-logo-img {
		transform: rotate(10deg);
	}

	.footer-logo h3 {
		font-size: 1.4rem;
		margin: 0;
		color: var(--border-color);
	}

	.footer-links h4,
	.footer-social h4,
	.footer-newsletter h4 {
		color: white;
		margin-bottom: 1.2rem;
		position: relative;
		padding-bottom: 0.8rem;
		font-size: 1.2rem;
	}

	.footer-links h4::after,
	.footer-social h4::after,
	.footer-newsletter h4::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 60px;
		height: 3px;
		background-color: var(--border-color);
		transform: scaleX(0.6667);
		transform-origin: left;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.footer-links:hover h4::after,
	.footer-social:hover h4::after,
	.footer-newsletter:hover h4::after {
		transform: scaleX(1);
	}

	.footer-links ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-links li {
		margin-bottom: 0.9rem;
	}

	.footer-link {
		color: #aaa;
		text-decoration: none;
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.3rem 0;
	}
	.footer-link:hover {
		color: white;
		transform: translateX(8px);
	}
	.footer-link i {
		color: var(--border-color);
		font-size: 0.9rem;
	}

	.social-icons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		background-color: rgba(255, 255, 255, 0.1);
		color: white;
		border-radius: 50%;
		text-decoration: none;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		overflow: hidden;
	}

	.social-icon:before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--border-color);
		transform: translateY(100%);
		transition: transform 0.3s ease;
		z-index: 1;
	}

	.social-icon i {
		position: relative;
		z-index: 2;
	}

	.social-icon:hover {
		transform: translateY(-5px);
		box-shadow: 0 5px 15px rgba(0, 160, 255, 0.3);
	}
	.social-icon:hover::before {
		transform: translateY(0);
	}

	.footer-newsletter p {
		color: #aaa;
		margin-bottom: 1rem;
	}

	.newsletter-form {
		display: flex;
		max-width: 100%;
	}

	.newsletter-input {
		padding: 0.8rem;
		border-radius: 6px 0 0 6px;
		border: none;
		background-color: rgba(255, 255, 255, 0.1);
		color: white;
		flex-grow: 1;
	}
	.newsletter-input:focus {
		outline: none;
		box-shadow: 0 0 0 2px rgba(0, 160, 255, 0.3);
	}

	.newsletter-button {
		padding: 0.8rem 1.2rem;
		border: none;
		background-color: var(--border-color);
		color: white;
		border-radius: 0 6px 6px 0;
		cursor: pointer;
		transition: all 0.3s ease;
	}
	.newsletter-button:hover {
		background-color: #0086d4;
		transform: translateX(3px);
	}

	.footer-bottom {
		max-width: 1200px;
		margin: 3rem auto 0;
		padding: 1.5rem 2rem 0;
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		font-size: 0.9rem;
		color: #888;
	}
	.footer-bottom a {
		color: var(--border-color);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}
	.footer-bottom a:hover {
		color: white;
	}

	@media (max-width: 1200px) {
		.footer-content {
			grid-template-columns: repeat(3, 1fr);
		}
		.footer-newsletter {
			grid-column: span 3;
		}
	}

	@media (max-width: 992px) {
		.footer-content {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 2rem;
		}
		.footer-newsletter {
			grid-column: span 2;
		}
	}

	@media (max-width: 768px) {
		.footer-logo,
		.footer-links,
		.footer-social {
			width: 100%;
		}
		.app-footer {
			padding: 3rem 0 1rem;
		}
		.footer-content {
			grid-template-columns: 1fr;
		}
		.footer-newsletter {
			grid-column: span 1;
		}
		.newsletter-form {
			max-width: 100%;
		}
		.social-icons {
			justify-content: center;
		}
		.footer-links ul {
			max-width: 300px;
		}
		.footer-bottom {
			margin-top: 2rem;
		}
	}

	@media (max-width: 480px) {
		.app-footer {
			padding: 2rem 0 1rem;
		}
		.footer-content {
			padding: 0 1rem;
			gap: 2rem;
		}
		.social-icons {
			gap: 0.8rem;
		}
		.social-icon {
			width: 38px;
			height: 38px;
		}
		.footer-logo h3 {
			font-size: 1.2rem;
		}
		.footer-bottom {
			padding: 1rem 1rem 0;
		}
	}
</style>
