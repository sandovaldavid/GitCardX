---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardEditorPanel from '../components/smart/CardEditorPanel.astro';
import ColorControlsPanel from '../components/smart/ColorControlsPanel.astro';
import ImageUploadPanel from '../components/smart/ImageUploadPanel.astro';
import ExportControls from '../components/smart/ExportControls.astro';
import ToastHost from '../components/smart/ToastHost.astro';
import CardPreview from '../components/ui/CardPreview.astro';
---

<BaseLayout>
	<header class="app-header">
		<div class="logo-container">
			<img
				src="/images/logo-github-card-generator.webp"
				alt="Logo"
				class="app-logo"
				width="50"
				height="50"
			/>
			<h1>GitCardX</h1>
		</div>
	</header>

	<main class="container">
		<section class="stage-rail" aria-label="Build pipeline status">
			<ol class="stage-rail-track">
				<li class="rail-node" data-stage="configure" data-status="pending">
					<span class="rail-node-dot"></span>
					<span class="rail-node-label">Configure</span>
					<span class="stage-pill stage-pill--pending" data-pill="configure">pending</span>
				</li>
				<li class="rail-connector" aria-hidden="true"></li>
				<li class="rail-node" data-stage="style" data-status="pending">
					<span class="rail-node-dot"></span>
					<span class="rail-node-label">Style</span>
					<span class="stage-pill stage-pill--pending" data-pill="style">pending</span>
				</li>
				<li class="rail-connector" aria-hidden="true"></li>
				<li class="rail-node" data-stage="assets" data-status="pending">
					<span class="rail-node-dot"></span>
					<span class="rail-node-label">Assets</span>
					<span class="stage-pill stage-pill--pending" data-pill="assets">pending</span>
				</li>
			</ol>
			<div class="rail-terminus" data-status="pending" aria-hidden="true">
				<span class="rail-terminus-arrow">↓</span>
				<span class="rail-terminus-label">feeds the build artifact below</span>
			</div>
		</section>

		<div class="app-layout">
			<div class="side-panel left-panel">
				<CardEditorPanel />
			</div>

			<div class="center-panel">
				<div class="preview-header">
					<h2><i class="fas fa-eye"></i> Preview</h2>
					<ExportControls />
				</div>

				<CardPreview />
			</div>

			<div class="side-panel right-panel">
				<ColorControlsPanel />
				<ImageUploadPanel />
			</div>
		</div>
	</main>

	<footer class="app-footer">
		<div class="footer-content">
			<div class="footer-logo">
				<img
					src="/images/logo-github-card-generator.webp"
					alt="Logo"
					class="footer-logo-img"
					width="40"
					height="40"
				/>
				<h3>GitCardX</h3>
			</div>

			<div class="footer-links">
				<h4>Links</h4>
				<ul>
					<li>
						<a href="/" class="footer-link"><i class="fas fa-home"></i> Home</a>
					</li>
					<li>
						<a
							href="https://github.com/sandovaldavid/gitHub-project-card-generator"
							target="_blank"
							class="footer-link"
						>
							<i class="fas fa-code"></i> Source Code
						</a>
					</li>
				</ul>
			</div>

			<div class="footer-social">
				<h4>Connect</h4>
				<div class="social-icons">
					<a
						href="https://github.com/sandovaldavid"
						class="social-icon"
						target="_blank"
						title="GitHub"><i class="fab fa-github"></i></a
					>
					<a href="https://x.com/XDavid2S" class="social-icon" target="_blank" title="Twitter"
						><i class="fab fa-twitter"></i></a
					>
					<a
						href="https://www.linkedin.com/in/jdavidsandovals/"
						class="social-icon"
						target="_blank"
						title="LinkedIn"><i class="fab fa-linkedin"></i></a
					>
					<a href="#" class="social-icon" target="_blank" title="Instagram"
						><i class="fab fa-instagram"></i></a
					>
				</div>
			</div>

		</div>

		<div class="footer-bottom">
			<p>
				&copy; <span id="current-year">2025</span> GitCardX | by
				<a href="https://github.com/sandovaldavid" target="_blank">@sandovaldavid</a>
			</p>
		</div>
	</footer>

	<ToastHost />
</BaseLayout>

<script>
	import { cardStore, colorStore, imageStore, stageStatusStore } from '../stores/cardState';
	import type { StageStatus } from '../stores/cardState';
	import { load, save } from '../lib/storage';
	import { AUTOSAVE_DEBOUNCE_MS } from '../constants/defaults';

	// Restore any saved settings before wiring the autosave subscriber, so the
	// initial restore doesn't immediately re-trigger a save.
	load();

	let saveTimer: ReturnType<typeof setTimeout> | undefined;
	function scheduleSave() {
		clearTimeout(saveTimer);
		saveTimer = setTimeout(save, AUTOSAVE_DEBOUNCE_MS);
	}

	cardStore.subscribe(scheduleSave);
	colorStore.subscribe(scheduleSave);
	imageStore.subscribe(scheduleSave);

	const currentYear = document.getElementById('current-year');
	if (currentYear) currentYear.textContent = String(new Date().getFullYear());

	// Stage-rail: reflects each panel's own reported validity from
	// stageStatusStore live, and derives the 4th "Build" node from the same
	// three keys rather than adding a new store field.
	type ConfigStage = 'configure' | 'style' | 'assets';
	const CONFIG_STAGES: ConfigStage[] = ['configure', 'style', 'assets'];

	const RAIL_LABELS: Record<StageStatus, string> = {
		pending: 'pending',
		running: 'validating',
		passing: 'passing',
		failing: 'failing',
	};

	function pulseRailNode(dot: Element | null) {
		if (!dot) return;
		dot.classList.remove('rail-node-pulse');
		// Force reflow so re-adding the class restarts the animation on rapid
		// consecutive status flips.
		void (dot as HTMLElement).offsetWidth;
		dot.classList.add('rail-node-pulse');
		window.setTimeout(() => dot.classList.remove('rail-node-pulse'), 900);
	}

	function renderRailNode(stage: ConfigStage, status: StageStatus, shouldPulse: boolean) {
		const node = document.querySelector(`.rail-node[data-stage="${stage}"]`);
		if (!node) return;
		node.setAttribute('data-status', status);
		const pill = node.querySelector('[data-pill]');
		if (pill) {
			pill.className = `stage-pill stage-pill--${status}`;
			pill.textContent = RAIL_LABELS[status];
		}
		if (shouldPulse) pulseRailNode(node.querySelector('.rail-node-dot'));
	}

	function deriveBuildStatus(state: Record<ConfigStage, StageStatus>): StageStatus {
		if (CONFIG_STAGES.every((stage) => state[stage] === 'passing')) return 'passing';
		if (CONFIG_STAGES.some((stage) => state[stage] === 'running')) return 'running';
		if (CONFIG_STAGES.some((stage) => state[stage] === 'failing')) return 'failing';
		return 'pending';
	}

	// The terminus is where the rail actually ends — it drives its own arrow
	// color and (via the identical derivation running independently in
	// CardPreview.astro, both reading the same stageStatusStore) the card
	// preview's own "BUILD ARTIFACT" tag lights up in sync, so the pipeline
	// visibly terminates at the real artifact instead of a duplicate pill.
	const railTerminus = document.querySelector('.rail-terminus');

	stageStatusStore.subscribe((state, _oldState, changedKey) => {
		if (changedKey) {
			renderRailNode(changedKey, state[changedKey], true);
		} else {
			CONFIG_STAGES.forEach((stage) => renderRailNode(stage, state[stage], false));
		}

		if (railTerminus) railTerminus.setAttribute('data-status', deriveBuildStatus(state));
	});
</script>

<style>
	.app-header {
		display: flex;
		justify-content: center;
		align-items: center;
		background-color: var(--neutral-bg);
		border-bottom: 1px solid var(--medium-gray);
		padding: 1.25rem 0;
	}

	.logo-container {
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	.app-logo {
		width: 50px;
		height: 50px;
		border-radius: 10px;
		margin-right: 1rem;
		transition: transform 0.3s ease;
	}
	.app-logo:hover {
		transform: rotate(5deg);
	}

	h1 {
		font-size: 2.25rem;
		margin: 0;
		color: var(--body-color);
	}

	@media (max-width: 768px) {
		.app-header {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 1rem 0;
		}
		.logo-container {
			justify-content: center;
			margin-bottom: 15px;
		}
		h1 {
			font-size: 1.8rem;
		}
	}

	@media (max-width: 480px) {
		.app-header {
			margin: 15px 0;
		}
		.app-logo {
			width: 40px;
			height: 40px;
		}
		h1 {
			font-size: 1.6rem;
		}
	}

	.stage-rail {
		margin-top: 2rem;
	}

	.stage-rail-track {
		display: flex;
		align-items: center;
		list-style: none;
		margin: 0;
		padding: 1.25rem 1.5rem;
		background-color: var(--neutral-bg);
		border: 1px solid var(--medium-gray);
		border-radius: 12px;
	}

	.rail-node {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		flex: 1 1 0;
		min-width: 0;
	}

	.rail-node-dot {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background-color: var(--status-pending);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-pending) 18%, transparent);
		transition:
			background-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.rail-node[data-status='running'] .rail-node-dot {
		background-color: var(--status-running);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-running) 18%, transparent);
	}
	.rail-node[data-status='passing'] .rail-node-dot {
		background-color: var(--status-passing);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-passing) 18%, transparent);
	}
	.rail-node[data-status='failing'] .rail-node-dot {
		background-color: var(--status-failing);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--status-failing) 18%, transparent);
	}

	.rail-node-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--label-color);
	}

	.rail-connector {
		flex: 0 0 48px;
		height: 2px;
		background-color: var(--medium-gray);
		align-self: center;
		margin: 0 -0.25rem;
	}

	@media (max-width: 768px) {
		.stage-rail-track {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
		}
		.rail-node {
			flex-direction: row;
			justify-content: flex-start;
			gap: 0.75rem;
			width: 100%;
		}
		.rail-connector {
			flex: 0 0 auto;
			width: 2px;
			height: 24px;
			margin: 2px 0 2px 6px;
		}
	}

	/* The rail's actual endpoint: it doesn't stop at another pill, it points
	   straight down into the live card preview below, which lights up its own
	   "BUILD ARTIFACT" tag from the same store (see CardPreview.astro). */
	.rail-terminus {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--medium-gray);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--label-color);
	}

	.rail-terminus-arrow {
		font-size: 0.9rem;
		color: var(--status-pending);
		transition: color 0.25s ease;
	}

	.rail-terminus[data-status='running'] .rail-terminus-arrow {
		color: var(--status-running);
	}
	.rail-terminus[data-status='passing'] .rail-terminus-arrow {
		color: var(--status-passing);
	}
	.rail-terminus[data-status='failing'] .rail-terminus-arrow {
		color: var(--status-failing);
	}

	.app-layout {
		display: grid;
		grid-template-columns: 3fr 5fr 2fr;
		gap: 2rem;
		margin-top: 2rem;
		min-height: calc(100vh - 300px);
	}

	.side-panel {
		background-color: var(--neutral-bg);
		border: 1px solid var(--medium-gray);
		border-radius: 12px;
		padding: 1.5rem;
		height: fit-content;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
	}

	.center-panel {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.preview-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	@media (max-width: 1200px) {
		.app-layout {
			grid-template-columns: 1fr 1fr;
		}
		.right-panel {
			grid-column: span 2;
			grid-row: 2;
		}
	}

	@media (max-width: 768px) {
		.app-layout {
			grid-template-columns: 1fr;
		}
		.left-panel,
		.center-panel,
		.right-panel {
			grid-column: 1;
		}
		.left-panel {
			grid-row: 1;
		}
		.center-panel {
			grid-row: 2;
		}
		.right-panel {
			grid-row: 3;
		}
	}

	.app-footer {
		background-color: var(--dark-gray);
		color: #f5f5f5;
		padding: 4rem 0 1rem;
		margin-top: 4rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		position: relative;
		overflow: hidden;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		padding: 0 2rem;
		position: relative;
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin-bottom: 1rem;
	}

	.footer-logo-img {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		transition: transform 0.3s ease;
	}
	.footer-logo:hover .footer-logo-img {
		transform: rotate(10deg);
	}

	.footer-logo h3 {
		font-size: 1.4rem;
		margin: 0;
		color: var(--primary-color);
	}

	.footer-links h4,
	.footer-social h4 {
		color: white;
		margin-bottom: 1.2rem;
		position: relative;
		padding-bottom: 0.8rem;
		font-size: 1.2rem;
	}

	.footer-links h4::after,
	.footer-social h4::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 60px;
		height: 3px;
		background-color: var(--primary-color);
		transform: scaleX(0.6667);
		transform-origin: left;
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.footer-links:hover h4::after,
	.footer-social:hover h4::after {
		transform: scaleX(1);
	}

	.footer-links ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-links li {
		margin-bottom: 0.9rem;
	}

	.footer-link {
		color: #aaa;
		text-decoration: none;
		transition: all 0.3s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.3rem 0;
	}
	.footer-link:hover {
		color: white;
		transform: translateX(8px);
	}
	.footer-link i {
		color: var(--primary-color);
		font-size: 0.9rem;
	}

	.social-icons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		min-width: 44px;
		min-height: 44px;
		background-color: rgba(255, 255, 255, 0.1);
		color: white;
		border-radius: 50%;
		text-decoration: none;
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		overflow: hidden;
	}

	.social-icon:before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--primary-color);
		transform: translateY(100%);
		transition: transform 0.3s ease;
		z-index: 1;
	}

	.social-icon i {
		position: relative;
		z-index: 2;
	}

	.social-icon:hover {
		transform: translateY(-5px);
		box-shadow: 0 5px 15px rgba(var(--primary-color-rgb), 0.3);
	}
	.social-icon:hover::before {
		transform: translateY(0);
	}
	/* Teal is a light accent; swap the icon glyph to a dark tone once it's
	   painted over so it keeps AA contrast against its own hover fill. */
	.social-icon:hover i {
		color: var(--dark-gray);
	}

	.footer-bottom {
		max-width: 1200px;
		margin: 3rem auto 0;
		padding: 1.5rem 2rem 0;
		text-align: center;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
		font-size: 0.9rem;
		color: #b3b3b3;
	}
	.footer-bottom a {
		color: var(--primary-color);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}
	.footer-bottom a:hover {
		color: white;
	}

	@media (max-width: 1200px) {
		.footer-content {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 992px) {
		.footer-content {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 2rem;
		}
	}

	@media (max-width: 768px) {
		.footer-logo,
		.footer-links,
		.footer-social {
			width: 100%;
		}
		.app-footer {
			padding: 3rem 0 1rem;
		}
		.footer-content {
			grid-template-columns: 1fr;
		}
		.social-icons {
			justify-content: center;
		}
		.footer-links ul {
			max-width: 300px;
		}
		.footer-bottom {
			margin-top: 2rem;
		}
	}

	@media (max-width: 480px) {
		.app-footer {
			padding: 2rem 0 1rem;
		}
		.footer-content {
			padding: 0 1rem;
			gap: 2rem;
		}
		.social-icons {
			gap: 0.8rem;
		}
		.social-icon {
			width: 44px;
			height: 44px;
		}
		.footer-logo h3 {
			font-size: 1.2rem;
		}
		.footer-bottom {
			padding: 1rem 1rem 0;
		}
	}
</style>
