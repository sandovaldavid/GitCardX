---
import ColorInput from '../ui/ColorInput.astro';
import { DEFAULT_COLORS } from '../../constants/defaults';
---

<div id="stylePanel" class="panel-section stage-panel mb-8 border-b border-medium-gray pb-6 last:mb-0 last:border-b-0 last:pb-0">
	<h2>
		<i class="fas fa-palette"></i> Style Customization
		<span class="stage-pill stage-pill--pending" id="styleStagePill">Style — pending</span>
	</h2>

	<div class="theme-presets">
		<h3 class="presets-title">Quick Presets</h3>
		<div class="presets-grid">
			<button class="preset-chip" type="button" data-bg="#0d1117" data-border="#30363d" data-project="#ffffff">
				<span class="preset-swatches">
					<span class="swatch" style="background: #0d1117"></span>
					<span class="swatch" style="background: #30363d"></span>
					<span class="swatch" style="background: #ffffff"></span>
				</span>
				GitHub Dark
			</button>
			<button class="preset-chip" type="button" data-bg="#0b0d10" data-border="#2dd4bf" data-project="#ffffff">
				<span class="preset-swatches">
					<span class="swatch" style="background: #0b0d10"></span>
					<span class="swatch" style="background: #2dd4bf"></span>
					<span class="swatch" style="background: #ffffff"></span>
				</span>
				Terminal Teal
			</button>
			<button class="preset-chip" type="button" data-bg="#0a0f1d" data-border="#38bdf8" data-project="#f8fafc">
				<span class="preset-swatches">
					<span class="swatch" style="background: #0a0f1d"></span>
					<span class="swatch" style="background: #38bdf8"></span>
					<span class="swatch" style="background: #f8fafc"></span>
				</span>
				Midnight Navy
			</button>
			<button class="preset-chip" type="button" data-bg="#1e1f29" data-border="#a6e22e" data-project="#f8f8f2">
				<span class="preset-swatches">
					<span class="swatch" style="background: #1e1f29"></span>
					<span class="swatch" style="background: #a6e22e"></span>
					<span class="swatch" style="background: #f8f8f2"></span>
				</span>
				Monokai Cyber
			</button>
			<button class="preset-chip" type="button" data-bg="#ffffff" data-border="#0969da" data-project="#1f2328">
				<span class="preset-swatches">
					<span class="swatch border-swatch" style="background: #ffffff"></span>
					<span class="swatch" style="background: #0969da"></span>
					<span class="swatch" style="background: #1f2328"></span>
				</span>
				Clean Light
			</button>
		</div>
	</div>
	<ColorInput
		id="bgColor"
		label="Background Color:"
		value={DEFAULT_COLORS.bgColor}
		targetIcon="fa-fill-drip"
		targetLabel="Background"
	/>
	<ColorInput
		id="borderColor"
		label="Bottom Border Color:"
		value={DEFAULT_COLORS.borderColor}
		targetIcon="fa-border-style"
		targetLabel="Bottom border"
	/>
	<ColorInput
		id="projectColor"
		label="Project Name Color:"
		value={DEFAULT_COLORS.projectColor}
		targetIcon="fa-heading"
		targetLabel="Heading text"
	/>
</div>

<script>
	import { colorStore, setStageStatus, stageStatusStore } from '../../stores/cardState';
	import type { StageStatus } from '../../stores/cardState';
	import { validateColor } from '../../utils/validators';
	import { pushToast } from '../../stores/cardState';
	import type { ColorData } from '../../stores/cardState';

	const inputIds: (keyof ColorData)[] = ['projectColor', 'borderColor', 'bgColor'];

	const inputs = Object.fromEntries(
		inputIds.map((id) => [id, document.getElementById(id) as HTMLInputElement])
	) as Record<keyof ColorData, HTMLInputElement>;

	const targetIcons = Object.fromEntries(
		inputIds.map((id) => [
			id,
			document.querySelector<HTMLElement>(`[data-color-icon-for="${id}"]`),
		])
	) as Record<keyof ColorData, HTMLElement | null>;

	const styleStagePill = document.getElementById('styleStagePill') as HTMLElement | null;

	// "style" stage validity: a color input always carries some value (native
	// color pickers never go blank), so there's no meaningful untouched/pending
	// state here — it's simply whether all 3 currently-typed values are valid.
	function computeStyleStatus(): StageStatus {
		return inputIds.every((id) => validateColor(inputs[id].value).isValid) ? 'passing' : 'failing';
	}

	stageStatusStore.subscribe((state) => {
		if (!styleStagePill) return;
		styleStagePill.className = `stage-pill stage-pill--${state.style}`;
		styleStagePill.textContent = `Style — ${state.style}`;
	});

	for (const id of inputIds) {
		inputs[id].addEventListener('input', () => {
			const value = inputs[id].value;
			const validation = validateColor(value);
			if (!validation.isValid) {
				pushToast(validation.message ?? 'Invalid color', 'error');
				setStageStatus('style', computeStyleStatus());
				return;
			}
			colorStore.setKey(id, value);
			if (targetIcons[id]) targetIcons[id]!.style.color = value;
			setStageStatus('style', computeStyleStatus());
		});
	}

	colorStore.subscribe((state) => {
		for (const id of inputIds) {
			if (inputs[id].value !== state[id]) inputs[id].value = state[id];
			const display = document.querySelector<HTMLElement>(`[data-color-value-for="${id}"]`);
			if (display) display.textContent = state[id];
			if (targetIcons[id]) targetIcons[id]!.style.color = state[id];
		}
	});

	// Initial status from the SSR-rendered default swatch values.
	setStageStatus('style', computeStyleStatus());

	const presetChips = document.querySelectorAll<HTMLButtonElement>('.preset-chip');
	presetChips.forEach(chip => {
		chip.addEventListener('click', () => {
			const bg = chip.dataset.bg;
			const border = chip.dataset.border;
			const project = chip.dataset.project;
			if (bg && border && project) {
				colorStore.set({ bgColor: bg, borderColor: border, projectColor: project });
				setStageStatus('style', computeStyleStatus());
			}
		});
	});
</script>

<style>
	.stage-panel {
		background-color: var(--neutral-bg);
		border: 1px solid var(--medium-gray);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.stage-panel h2 {
		flex-wrap: wrap;
		row-gap: 8px;
	}

	.theme-presets {
		margin: 1.5rem 0;
	}
	.presets-title {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--label-color);
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.presets-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.preset-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.75rem;
		background: var(--neutral-bg);
		border: 1px solid var(--medium-gray);
		border-radius: 20px;
		font-size: 0.8rem;
		color: var(--body-color);
		cursor: pointer;
		transition: all 0.2s ease;
	}
	.preset-chip:hover, .preset-chip:focus {
		border-color: var(--primary-color);
		background: color-mix(in srgb, var(--primary-color) 10%, transparent);
		outline: none;
	}
	.preset-swatches {
		display: flex;
		gap: 2px;
	}
	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.border-swatch {
		border-color: var(--medium-gray);
	}
</style>
