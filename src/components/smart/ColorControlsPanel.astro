---
import ColorInput from '../ui/ColorInput.astro';
import { DEFAULT_COLORS } from '../../constants/defaults';
---

<div class="panel-section stage-panel mb-8 border-b border-medium-gray pb-6 last:mb-0 last:border-b-0 last:pb-0">
	<h2>
		<i class="fas fa-palette"></i> Style Customization
		<span class="stage-pill stage-pill--pending" id="styleStagePill">Style — pending</span>
	</h2>
	<ColorInput
		id="bgColor"
		label="Background Color:"
		value={DEFAULT_COLORS.bgColor}
		targetIcon="fa-fill-drip"
		targetLabel="Background"
	/>
	<ColorInput
		id="borderColor"
		label="Bottom Border Color:"
		value={DEFAULT_COLORS.borderColor}
		targetIcon="fa-border-style"
		targetLabel="Bottom border"
	/>
	<ColorInput
		id="projectColor"
		label="Project Name Color:"
		value={DEFAULT_COLORS.projectColor}
		targetIcon="fa-heading"
		targetLabel="Heading text"
	/>
</div>

<script>
	import { colorStore, setStageStatus, stageStatusStore } from '../../stores/cardState';
	import type { StageStatus } from '../../stores/cardState';
	import { validateColor } from '../../utils/validators';
	import { pushToast } from '../../stores/cardState';
	import type { ColorData } from '../../stores/cardState';

	const inputIds: (keyof ColorData)[] = ['projectColor', 'borderColor', 'bgColor'];

	const inputs = Object.fromEntries(
		inputIds.map((id) => [id, document.getElementById(id) as HTMLInputElement])
	) as Record<keyof ColorData, HTMLInputElement>;

	const targetIcons = Object.fromEntries(
		inputIds.map((id) => [
			id,
			document.querySelector<HTMLElement>(`[data-color-icon-for="${id}"]`),
		])
	) as Record<keyof ColorData, HTMLElement | null>;

	const styleStagePill = document.getElementById('styleStagePill') as HTMLElement | null;

	// "style" stage validity: a color input always carries some value (native
	// color pickers never go blank), so there's no meaningful untouched/pending
	// state here — it's simply whether all 3 currently-typed values are valid.
	function computeStyleStatus(): StageStatus {
		return inputIds.every((id) => validateColor(inputs[id].value).isValid) ? 'passing' : 'failing';
	}

	stageStatusStore.subscribe((state) => {
		if (!styleStagePill) return;
		styleStagePill.className = `stage-pill stage-pill--${state.style}`;
		styleStagePill.textContent = `Style — ${state.style}`;
	});

	for (const id of inputIds) {
		inputs[id].addEventListener('input', () => {
			const value = inputs[id].value;
			const validation = validateColor(value);
			if (!validation.isValid) {
				pushToast(validation.message ?? 'Invalid color', 'error');
				setStageStatus('style', computeStyleStatus());
				return;
			}
			colorStore.setKey(id, value);
			if (targetIcons[id]) targetIcons[id]!.style.color = value;
			setStageStatus('style', computeStyleStatus());
		});
	}

	colorStore.subscribe((state) => {
		for (const id of inputIds) {
			if (inputs[id].value !== state[id]) inputs[id].value = state[id];
			const display = document.querySelector<HTMLElement>(`[data-color-value-for="${id}"]`);
			if (display) display.textContent = state[id];
			if (targetIcons[id]) targetIcons[id]!.style.color = state[id];
		}
	});

	// Initial status from the SSR-rendered default swatch values.
	setStageStatus('style', computeStyleStatus());
</script>

<style>
	.stage-panel {
		background-color: var(--neutral-bg);
		border: 1px solid var(--medium-gray);
		border-radius: 12px;
		padding: 1.5rem;
	}

	.stage-panel h2 {
		flex-wrap: wrap;
		row-gap: 8px;
	}
</style>
