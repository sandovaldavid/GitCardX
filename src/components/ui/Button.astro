---
interface Props {
	id?: string;
	variant?: 'action' | 'primary' | 'download' | 'reset' | 'small';
	class?: string;
}

const { id, variant = 'action', class: className } = Astro.props;
---

<button id={id} class:list={['btn', `btn-${variant}`, className]}>
	<slot />
</button>

<style>
	.btn {
		padding: 10px 15px;
		min-height: 44px;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		font-weight: 500;
		transition: all 0.2s;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.btn-action {
		background-color: var(--neutral-bg);
		color: var(--body-color);
	}
	.btn-action:hover {
		background-color: var(--neutral-bg-hover);
	}

	.btn-primary {
		background-color: var(--primary-color);
		color: var(--light-gray);
		padding: 12px 18px;
		font-size: 16px;
	}
	.btn-primary:hover {
		background-color: var(--primary-color-hover);
		transform: translateY(-1px);
	}

	.btn-download {
		background-color: var(--secondary-color);
		color: white;
		padding: 12px 18px;
		font-size: 16px;
	}
	.btn-download:hover {
		background-color: var(--secondary-color-hover);
		transform: translateY(-1px);
	}

	.btn-reset {
		background-color: var(--neutral-bg);
		color: var(--label-color);
	}
	.btn-reset:hover {
		background-color: var(--neutral-bg-hover);
		color: var(--body-color);
	}

	.btn-small {
		background-color: var(--danger-color);
		color: var(--light-gray);
		padding: 6px 10px;
		min-height: 44px;
		font-size: 0.8rem;
	}
	.btn-small:hover {
		background-color: var(--danger-color-hover);
	}
</style>
