---
import { GITHUB_API } from '../../constants/github';
---

<div id="cardContainer">
	<div id="githubCard" class="card">
		<div class="card-header">
			<div class="title-info">
				<h1 id="displayTitle" class="repo-title">
					<span id="displayUsername">username</span><span class="title-separator">/</span><span
						id="displayRepoName">repository-name</span
					>
				</h1>
			</div>
			<img
				id="profilePic"
				src={GITHUB_API.DEFAULT_AVATAR}
				alt="Profile Picture"
				class="profile-pic"
				width="40"
				height="40"
			/>
		</div>
		<div class="card-body">
			<p id="displayDescription" class="project-description"></p>
		</div>
		<div class="card-footer">
			<div id="statsRow" class="stats-row" style="display: none;">
				<span class="stat-chip">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path></svg>
					<span id="displayStarCount" class="stat-count">0</span>
				</span>
				<span class="stat-chip">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor"><path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v.878A2.25 2.25 0 0 0 5.75 8.5h4.5A2.25 2.25 0 0 0 12.5 6.25v-.878a2.25 2.25 0 1 0-1.5 0v.878a.75.75 0 0 1-.75.75h-4.5A.75.75 0 0 1 5 6.25v-.878ZM10.5 3.25a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0ZM5 12.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0V9.25a.75.75 0 0 1 1.5 0v5.622Z"></path></svg>
					<span id="displayForkCount" class="stat-count">0</span>
				</span>
				<span id="langChip" class="stat-chip" style="display: none;">
					<span id="langDot" class="lang-dot"></span>
					<span id="displayLanguage" class="stat-text"></span>
				</span>
			</div>
			<div id="logoContainer" class="logo-container"></div>
		</div>
		<div id="languageBar" class="language-bar" style="display: none;"></div>
	</div>
</div>

<script>
	import { cardStore, colorStore, imageStore, stageStatusStore } from '../../stores/cardState';
	import type { StageStatus } from '../../stores/cardState';
	import { setCSSVariables } from '../../utils/dom';
	import { formatCompactNumber } from '../../utils/formatters';

	const displayUsername = document.getElementById('displayUsername');
	const profilePic = document.getElementById('profilePic') as HTMLImageElement | null;
	const displayRepoName = document.getElementById('displayRepoName');
	const displayDescription = document.getElementById('displayDescription') as HTMLElement | null;
	const statsRow = document.getElementById('statsRow') as HTMLElement | null;
	const displayStarCount = document.getElementById('displayStarCount');
	const displayForkCount = document.getElementById('displayForkCount');
	const langChip = document.getElementById('langChip');
	const langDot = document.getElementById('langDot');
	const displayLanguage = document.getElementById('displayLanguage');
	const languageBar = document.getElementById('languageBar') as HTMLElement | null;
	const logoContainer = document.getElementById('logoContainer');
	const card = document.getElementById('githubCard');
	const cardContainer = document.getElementById('cardContainer') as HTMLElement | null;

	cardStore.subscribe((state) => {
		if (displayUsername) displayUsername.textContent = state.username || 'username';
		if (profilePic) profilePic.src = state.avatarUrl;
		if (displayRepoName) displayRepoName.textContent = state.repoName || 'repository-name';
		if (displayDescription) {
			displayDescription.textContent = state.projectDescription || '';
			// '' (not 'block') so the stylesheet's `display: -webkit-box` (the
			// line-clamp trigger) takes over when visible — an inline 'block'
			// would silently disable the clamp.
			displayDescription.style.display = state.projectDescription ? '' : 'none';
		}

		// Stats and the language bar only mean anything once a repo has
		// actually been loaded or manually entered — before that, hide them
		// instead of showing misleading "0 stars/0 forks" placeholders.
		const hasRepoOrMetrics = Boolean(state.repoName) || state.starCount > 0 || state.forkCount > 0 || Boolean(state.primaryLanguage);

		if (statsRow) {
			statsRow.style.display = hasRepoOrMetrics && state.showStats ? 'flex' : 'none';
		}
		if (displayStarCount) displayStarCount.textContent = formatCompactNumber(state.starCount);
		if (displayForkCount) displayForkCount.textContent = formatCompactNumber(state.forkCount);

		if (langChip && langDot && displayLanguage) {
			if (state.primaryLanguage) {
				langChip.style.display = 'inline-flex';
				displayLanguage.textContent = state.primaryLanguage;
				langDot.style.backgroundColor = state.primaryLanguageColor || '#2dd4bf';
			} else {
				langChip.style.display = 'none';
			}
		}

		if (languageBar) {
			if (state.showLanguageBar && state.languages && state.languages.length > 0) {
				languageBar.style.display = 'flex';
				languageBar.replaceChildren(
					...state.languages.map((slice) => {
						const segment = document.createElement('span');
						segment.className = 'language-segment';
						segment.style.flexBasis = `${slice.percentage}%`;
						segment.style.backgroundColor = slice.color;
						segment.title = `${slice.name} (${slice.percentage.toFixed(1)}%)`;
						return segment;
					})
				);
			} else {
				languageBar.style.display = 'none';
				languageBar.replaceChildren();
			}
		}
	});

	const displayTitle = document.getElementById('displayTitle');

	colorStore.subscribe((state) => {
		// "Project Name Color" (ColorControlsPanel) now targets the
		// consolidated title heading, since the old standalone project-name
		// heading it used to color no longer exists.
		if (displayTitle) (displayTitle as HTMLElement).style.color = state.projectColor;
		setCSSVariables({ '--border-color': state.borderColor, '--bg-color': state.bgColor });
		if (cardContainer) cardContainer.style.borderBottomColor = state.borderColor;
	});

	imageStore.subscribe((state) => {
		if (logoContainer) {
			logoContainer.replaceChildren();
			if (state.logoDataUrl) {
				const img = document.createElement('img');
				img.src = state.logoDataUrl;
				img.alt = 'Project Logo';
				img.className = 'project-logo';
				img.height = 48;
				logoContainer.appendChild(img);
			}
		}

		if (card) {
			if (state.backgroundDataUrl) {
				card.style.backgroundImage = `url(${state.backgroundDataUrl})`;
				card.style.backgroundSize = 'cover';
				card.style.backgroundPosition = 'center';
				card.classList.add('has-bg-image');
			} else {
				card.style.backgroundImage = 'none';
				card.classList.remove('has-bg-image');
			}
		}

		setCSSVariables({ '--bg-overlay-opacity': state.backgroundOpacity });
	});

	// This preview IS the pipeline's "Build Artifact" node from the
	// stage-rail (src/pages/index.astro): it derives the same aggregate
	// status from stageStatusStore and reflects it on its own "BUILD
	// ARTIFACT" tag, so the rail visibly terminates here instead of at a
	// disconnected duplicate pill.
	type ConfigStage = 'configure' | 'style' | 'assets';
	const CONFIG_STAGES: ConfigStage[] = ['configure', 'style', 'assets'];

	function deriveBuildStatus(state: Record<ConfigStage, StageStatus>): StageStatus {
		if (CONFIG_STAGES.every((stage) => state[stage] === 'passing')) return 'passing';
		if (CONFIG_STAGES.some((stage) => state[stage] === 'running')) return 'running';
		if (CONFIG_STAGES.some((stage) => state[stage] === 'failing')) return 'failing';
		return 'pending';
	}

	stageStatusStore.subscribe((state) => {
		if (cardContainer) cardContainer.dataset.buildStatus = deriveBuildStatus(state);
	});
</script>

<style>
	#cardContainer {
		position: relative;
		background-color: var(--neutral-bg);
		border: 1px solid color-mix(in srgb, var(--primary-color) 20%, var(--medium-gray));
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
		overflow: hidden;
		aspect-ratio: 2 / 1;
		width: 100%;
		border-bottom: 2rem solid var(--border-color);
		transition: box-shadow 0.3s ease;
	}

	/* Reflects the same aggregate status the stage-rail terminus derives
	   (src/pages/index.astro) — this is where the pipeline actually ends. */
	#cardContainer[data-build-status='passing'] {
		box-shadow: 0 4px 20px color-mix(in srgb, var(--status-passing) 25%, transparent);
	}

	#cardContainer::before {
		content: 'BUILD ARTIFACT';
		position: absolute;
		top: 10px;
		left: 10px;
		font-family: var(--mono-font);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--label-color);
		background-color: color-mix(in srgb, var(--light-gray) 75%, transparent);
		padding: 3px 8px;
		border-radius: 4px;
		pointer-events: none;
		z-index: 10;
		transition: color 0.25s ease;
	}

	#cardContainer[data-build-status='passing']::before {
		color: var(--status-passing);
	}
	#cardContainer[data-build-status='failing']::before {
		color: var(--status-failing);
	}

	#cardContainer::after {
		content: '1280 × 640 px';
		position: absolute;
		bottom: 10px;
		right: 10px;
		font-family: var(--mono-font);
		font-size: 12px;
		color: var(--label-color);
		background-color: color-mix(in srgb, var(--light-gray) 75%, transparent);
		padding: 2px 6px;
		border-radius: 4px;
		pointer-events: none;
		z-index: 10;
	}

	.card {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		padding: 25px;
		background-color: var(--bg-color);
		overflow: hidden;
		color: white;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		font-family: 'Manrope', sans-serif;
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
	}

	.card.has-bg-image::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, var(--bg-overlay-opacity));
		z-index: 1;
		pointer-events: none;
	}

	.card-header,
	.card-body,
	.card-footer {
		position: relative;
		z-index: 2;
	}

	.card-header {
		padding: 20px;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		height: 80px;
		min-height: 80px;
		font-family: var(--primary-font);
		gap: 12px;
	}

	.title-info {
		display: flex;
		align-items: center;
		min-width: 0;
		flex: 1 1 auto;
	}

	.repo-title {
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 1.6rem;
		margin: 0;
	}

	#displayUsername {
		font-weight: 300;
		opacity: 0.85;
	}

	.title-separator {
		font-weight: 300;
		opacity: 0.6;
		margin: 0 2px;
	}

	#displayRepoName {
		font-weight: 700;
	}

	.profile-pic {
		flex-shrink: 0;
		width: 40px;
		height: 40px;
		border-radius: 50%;
	}

	.card-body {
		flex-grow: 1;
		padding: 20px;
		display: flex;
		align-items: center;
		overflow: hidden;
		min-height: 100px;
	}

	.card-footer {
		position: relative;
		height: auto;
		min-height: 80px;
		padding: 0 20px 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
	}

	.stats-row {
		display: flex;
		gap: 16px;
	}

	.stat-chip {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--label-color);
		font-size: 1rem;
	}

	.stat-chip svg {
		fill: currentColor;
	}

	.lang-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		display: inline-block;
		margin-right: 4px;
	}

	.stat-count {
		font-family: var(--mono-font);
		font-weight: 600;
	}

	.project-description {
		font-size: 1.2rem;
		line-height: 1.5;
		color: #c9d1d9;
		width: 100%;
		max-width: 80%;
		margin: 0 auto;
		text-align: justify;
		opacity: 0.9;
		font-family: var(--primary-font);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.project-logo {
		width: auto;
		height: 3rem;
		object-fit: cover;
		border-radius: 5px;
	}

	.card-footer .logo-container {
		display: flex;
		align-items: center;
		justify-content: center;
		max-height: 4rem;
	}

	/* .card has 25px padding on every side; extend the bar past it with
	   negative margins so it reaches the card's true left/right/bottom
	   edges (matching GitHub's own edge-to-edge language bar) instead of
	   sitting inset like a regular padded child. #cardContainer's own
	   border-radius + overflow:hidden (which .card exactly fills) already
	   clips the bottom corners, so no radius is needed here. */
	.language-bar {
		display: flex;
		width: calc(100% + 50px);
		margin: 0 -25px -25px;
		height: 6px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.language-segment {
		flex-grow: 0;
		flex-shrink: 0;
		height: 100%;
	}

	@media (max-width: 480px) {
		.card-header {
			padding: 15px;
			height: 60px;
		}

		.repo-title {
			font-size: 1.1rem;
		}

		.stats-row {
			gap: 10px;
		}

		.card-footer {
			min-height: 60px;
			padding: 0 15px 15px;
		}

		.project-logo {
			height: 2.5rem;
		}
	}
</style>
