---
import { GITHUB_API } from '../../constants/github';
---

<div id="cardContainer">
	<div id="githubCard" class="card">
		<div class="card-header">
			<div class="repo-info">
				<img
					src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png"
					alt="GitHub Logo"
					class="github-logo"
					width="30"
					height="30"
				/>
				<span id="displayRepoName">/repository-name</span>
			</div>
			<div class="user-info">
				<span id="displayUsername">username</span>
				<img
					id="profilePic"
					src={GITHUB_API.DEFAULT_AVATAR}
					alt="Profile Picture"
					class="profile-pic"
					width="40"
					height="40"
				/>
			</div>
		</div>
		<div class="card-body">
			<p id="displayDescription" class="project-description"></p>
		</div>
		<div class="card-footer">
			<h2 id="displayProjectName">Project Name</h2>
			<div id="logoContainer" class="logo-container"></div>
		</div>
	</div>
</div>

<script>
	import { cardStore, colorStore, imageStore } from '../../stores/cardState';
	import { setCSSVariables } from '../../utils/dom';

	const displayUsername = document.getElementById('displayUsername');
	const profilePic = document.getElementById('profilePic') as HTMLImageElement | null;
	const displayRepoName = document.getElementById('displayRepoName');
	const displayProjectName = document.getElementById('displayProjectName');
	const displayDescription = document.getElementById('displayDescription') as HTMLElement | null;
	const logoContainer = document.getElementById('logoContainer');
	const card = document.getElementById('githubCard');
	const cardContainer = document.getElementById('cardContainer') as HTMLElement | null;

	cardStore.subscribe((state) => {
		if (displayUsername) displayUsername.textContent = state.username || 'username';
		if (profilePic) profilePic.src = state.avatarUrl;
		if (displayRepoName) displayRepoName.textContent = state.repoName ? `/${state.repoName}` : '/repository-name';
		if (displayProjectName) displayProjectName.textContent = state.projectName || 'Project Name';
		if (displayDescription) {
			displayDescription.textContent = state.projectDescription || '';
			displayDescription.style.display = state.projectDescription ? 'block' : 'none';
		}
	});

	colorStore.subscribe((state) => {
		if (displayProjectName) (displayProjectName as HTMLElement).style.color = state.projectColor;
		setCSSVariables({ '--border-color': state.borderColor, '--bg-color': state.bgColor });
		if (cardContainer) cardContainer.style.borderBottomColor = state.borderColor;
	});

	imageStore.subscribe((state) => {
		if (logoContainer) {
			logoContainer.replaceChildren();
			if (state.logoDataUrl) {
				const img = document.createElement('img');
				img.src = state.logoDataUrl;
				img.alt = 'Project Logo';
				img.className = 'project-logo';
				img.height = 48;
				logoContainer.appendChild(img);
			}
		}

		if (card) {
			if (state.backgroundDataUrl) {
				card.style.backgroundImage = `url(${state.backgroundDataUrl})`;
				card.style.backgroundSize = 'cover';
				card.style.backgroundPosition = 'center';
				card.classList.add('has-bg-image');
			} else {
				card.style.backgroundImage = 'none';
				card.classList.remove('has-bg-image');
			}
		}

		setCSSVariables({ '--bg-overlay-opacity': state.backgroundOpacity });
	});
</script>

<style>
	#cardContainer {
		position: relative;
		background-color: var(--neutral-bg);
		border-radius: 12px;
		box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		overflow: hidden;
		aspect-ratio: 2 / 1;
		width: 100%;
		border-bottom: 2rem solid var(--border-color);
	}

	#cardContainer::after {
		content: '1280 × 640 px';
		position: absolute;
		bottom: 10px;
		right: 10px;
		font-size: 12px;
		color: #666;
		background-color: rgba(255, 255, 255, 0.7);
		padding: 2px 6px;
		border-radius: 4px;
		pointer-events: none;
		z-index: 10;
	}

	.card {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		padding: 25px;
		background-color: var(--bg-color);
		overflow: hidden;
		color: white;
		display: flex;
		flex-direction: column;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		font-family: 'Manrope', sans-serif;
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
	}

	.card.has-bg-image::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-color: rgba(0, 0, 0, var(--bg-overlay-opacity));
		z-index: 1;
		pointer-events: none;
	}

	.card-header,
	.card-body,
	.card-footer {
		position: relative;
		z-index: 2;
	}

	.card-header {
		padding: 20px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 80px;
		min-height: 80px;
		font-family: var(--primary-font);
	}

	.repo-info,
	.user-info {
		display: flex;
		align-items: center;
		min-width: 0;
	}

	.github-logo {
		width: 30px;
		height: 30px;
		margin-right: 10px;
		border-radius: 50%;
	}

	#displayRepoName {
		font-size: 1.5rem;
		font-weight: 600;
		max-width: 100%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	#displayUsername {
		font-size: 1.2rem;
		margin-right: 10px;
		font-weight: bold;
		max-width: 12rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.profile-pic {
		width: 40px;
		height: 40px;
		border-radius: 50%;
	}

	.card-body {
		flex-grow: 1;
		padding: 20px;
		display: flex;
		align-items: center;
		overflow-y: auto;
		min-height: 100px;
	}

	.card-footer {
		position: relative;
		height: auto;
		min-height: 120px;
		padding-bottom: 80px;
		padding-left: 20px;
		display: block;
		margin-top: auto;
	}

	#displayProjectName {
		font-size: 2.5rem;
		font-weight: bold;
		font-family: var(--primary-font);
		width: 100%;
		margin-bottom: 10px;
		text-align: left;
	}

	.project-description {
		font-size: 1.2rem;
		line-height: 1.5;
		color: #c9d1d9;
		max-width: 80%;
		margin: 0 auto;
		text-align: justify;
		opacity: 0.9;
		font-family: var(--primary-font);
	}

	.project-logo {
		width: auto;
		height: 3rem;
		object-fit: cover;
		border-radius: 5px;
	}

	.card-footer .logo-container {
		position: absolute;
		bottom: 20px;
		right: 20px;
		max-height: 8rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	@media (max-width: 480px) {
		.card-header {
			padding: 15px;
			height: 60px;
		}

		#displayRepoName {
			font-size: 1.1rem;
		}

		#displayUsername {
			font-size: 0.9rem;
			max-width: 6rem;
		}

		#displayProjectName {
			font-size: 1.8rem;
		}

		.card-footer {
			min-height: 100px;
			padding-bottom: 60px;
		}

		.project-logo {
			height: 2.5rem;
		}
	}
</style>
