---
interface Props {
	id: string;
	label: string;
	value: string;
}

const { id, label, value } = Astro.props;
---

<div class="control-group mb-4 last:mb-0">
	<label for={id} class="block mb-2 font-medium text-label">{label}</label>
	<div class="color-input-group">
		<input type="color" id={id} value={value} />
		<span class="color-value" data-color-value-for={id}>{value}</span>
	</div>
</div>

<style>
	.color-input-group {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	input[type='color'] {
		width: 44px;
		height: 44px;
		border: none;
		border-radius: 6px;
		cursor: pointer;
	}

	input[type='color']::-webkit-color-swatch-wrapper {
		padding: 0;
	}

	input[type='color']::-webkit-color-swatch {
		border: none;
		border-radius: 6px;
	}

	.color-value {
		font-family: monospace;
		font-size: 14px;
		color: #666;
	}
</style>
