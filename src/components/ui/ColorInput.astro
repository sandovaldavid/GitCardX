---
interface Props {
	id: string;
	label: string;
	value: string;
}

const { id, label, value } = Astro.props;
---

<div class="control-group">
	<label for={id}>{label}</label>
	<div class="color-input-group">
		<input type="color" id={id} value={value} />
		<span class="color-value" data-color-value-for={id}>{value}</span>
	</div>
</div>

<style>
	.control-group {
		margin-bottom: 15px;
	}
	.control-group:last-child {
		margin-bottom: 0;
	}

	label {
		display: block;
		margin-bottom: 8px;
		font-weight: 500;
		color: #555;
	}

	.color-input-group {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	input[type='color'] {
		width: 40px;
		height: 40px;
		border: none;
		border-radius: 6px;
		cursor: pointer;
	}

	input[type='color']::-webkit-color-swatch-wrapper {
		padding: 0;
	}

	input[type='color']::-webkit-color-swatch {
		border: none;
		border-radius: 6px;
	}

	.color-value {
		font-family: monospace;
		font-size: 14px;
		color: #666;
	}
</style>
